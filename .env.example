# Used by `docker compose up` to configure both services. Copy to `.env`
# and fill in LLM_API_KEY - never commit the real .env file.

# Anthropic API key (required for grounded answers; the app still runs
# without it, but /api/chat returns LLM_ERROR until it's set)
LLM_API_KEY=
LLM_MODEL=claude-opus-5

# RAG tuning
TOP_K=5
SIMILARITY_THRESHOLD=0.35
RERANKER_ENABLED=false
MAX_CONTEXT_CHARS=12000
MAX_QUESTION_LENGTH=2000
CONVERSATION_HISTORY_LIMIT=6
MAX_UPLOAD_SIZE_MB=20

# Cross-service URLs (defaults match `docker compose up` port mappings)
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000/api
