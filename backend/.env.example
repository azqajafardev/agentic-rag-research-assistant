APP_NAME=EvidenceRAG API
APP_ENV=development
DEBUG=true

DATABASE_URL=sqlite:///./data/evidencerag.db

UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=20

FRONTEND_URL=http://localhost:5173


# ==============================
# Embeddings
# ==============================
# Local embedding model - API key NOT required
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_API_KEY=


# ==============================
# Vector Store
# ==============================
VECTOR_DB_PATH=./data/chroma


# ==============================
# Retrieval
# ==============================
TOP_K=5
SIMILARITY_THRESHOLD=0.35


# ==============================
# Reranking
# ==============================
RERANKER_ENABLED=false


# ==============================
# LLM Provider
# ==============================
# Options: anthropic, groq
#
# groq is a free/low-cost option for local development - no Anthropic
# credits required. Get a free API key at https://console.groq.com/keys
LLM_PROVIDER=groq

# --- Groq (recommended for development - free tier) ---
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=

# --- Anthropic (production) ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5
# LLM_API_KEY=


# ==============================
# Chat / Context
# ==============================
MAX_CONTEXT_CHARS=12000
MAX_QUESTION_LENGTH=2000
CONVERSATION_HISTORY_LIMIT=6
